    "@types/node": "20.16.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.11",
    "typescript": "5.5.4"
  },
  "overrides": {
