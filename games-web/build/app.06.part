    const setup=['r','n','b','q','k','b','n','r'];
    let b=Array(64).fill(null);
    for(let x=0;x<8;x++){b[x]={t:setup[x],p:2};b[8+x]={t:'p',p:2};b[48+x]={t:'p',p:1};b[56+x]={t:setup[x],p:1};}
    let p=1,cursor=52,sel=null,done=false;
    const glyph={k:'♚',q:'♛',r:'♜',b:'♝',n:'♞',p:'♟'};
    root.innerHTML='<div class="board checkerboard chess" role="grid" aria-label="Chess board"></div>';
    const el=$('.chess',root),xy=i=>[i%8,Math.floor(i/8)],idx=(x,y)=>y*8+x;
    function pathClear(fx,fy,tx,ty){const dx=Math.sign(tx-fx),dy=Math.sign(ty-fy);let x=fx+dx,y=fy+dy;while(x!==tx||y!==ty){if(b[idx(x,y)])return false;x+=dx;y+=dy;}return true;}
    function valid(from,to){const pc=b[from];if(!pc||pc.p!==p||b[to]?.p===p)return false;const[fx,fy]=xy(from),[tx,ty]=xy(to),dx=tx-fx,dy=ty-fy,ax=Math.abs(dx),ay=Math.abs(dy);if(pc.t==='n')return ax*ay===2;if(pc.t==='k')return Math.max(ax,ay)===1;if(pc.t==='r')return (dx===0||dy===0)&&pathClear(fx,fy,tx,ty);if(pc.t==='b')return ax===ay&&pathClear(fx,fy,tx,ty);if(pc.t==='q')return (dx===0||dy===0||ax===ay)&&pathClear(fx,fy,tx,ty);if(pc.t==='p'){const dir=pc.p===1?-1:1,start=pc.p===1?6:1;if(dx===0&&!b[to]&&dy===dir)return true;if(dx===0&&!b[to]&&fy===start&&dy===2*dir&&!b[idx(fx,fy+dir)])return true;if(ax===1&&dy===dir&&b[to]&&b[to].p!==pc.p)return true;}return false;}
    function threatened(square,byPlayer){const old=p;p=byPlayer;let yes=false;for(let i=0;i<64&&!yes;i++)if(b[i]?.p===byPlayer&&valid(i,square))yes=true;p=old;return yes;}
    function inCheck(player){const king=b.findIndex(x=>x?.p===player&&x.t==='k');return king>=0&&threatened(king,player===1?2:1);}
    function move(to){if(sel==null||!valid(sel,to))return;const pc=b[sel],target=b[to];b[to]=pc;b[sel]=null;const y=Math.floor(to/8);if(pc.t==='p'&&(y===0||y===7))pc.t='q';cursor=to;sel=null;beep(470,.04);if(target?.t==='k'){done=true;setStatus(`Player ${p} wins!`,'message-win');recordResult('chess','win');beep(820,.13);}else{p=p===1?2:1;setStatus(`Player ${p}'s turn${inCheck(p)?' — Check!':''}`);}render();}
    function choose(i){if(done)return;if(sel!=null&&i!==sel&&b[i]?.p!==p){move(i);return;}if(b[i]?.p===p){sel=i;cursor=i;render();}}
    function render(){const legal=sel==null?[]:[...Array(64).keys()].filter(i=>valid(sel,i));el.innerHTML=b.map((pc,i)=>`<button class="cell ${(Math.floor(i/8)+i%8)%2?'dark':'light'} ${i===sel?'selected':''} ${legal.includes(i)?'legal':''} ${i===cursor?'focused':''}" data-i="${i}" aria-label="${pc?`player ${pc.p} ${pc.t}`:'empty'}">${pc?`<span class="${pc.p===1?'white-piece':'black-piece'}">${glyph[pc.t]}</span>`:''}</button>`).join('');$$('.cell',el).forEach(x=>x.onclick=()=>{cursor=+x.dataset.i;choose(cursor)});if(!statusEl.textContent)setStatus("Player 1's turn");}
    const key=e=>{let x=cursor%8,y=Math.floor(cursor/8);if(e.key==='ArrowLeft'&&x>0)cursor--;else if(e.key==='ArrowRight'&&x<7)cursor++;else if(e.key==='ArrowUp'&&y>0)cursor-=8;else if(e.key==='ArrowDown'&&y<7)cursor+=8;else if(e.key==='Enter'||e.key===' '){e.preventDefault();choose(cursor);return;}else return;e.preventDefault();render();};window.addEventListener('keydown',key);render();return()=>window.removeEventListener('keydown',key);
  }

