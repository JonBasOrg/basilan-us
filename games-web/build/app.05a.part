    const icons=['★','☀','☂','♣','♦','♫','⚡','☕'];
    let tiles=shuffle([...icons,...icons].map((v,i)=>({v,up:false,match:false,id:i})));
    let cursor=0,first=null,busy=false,moves=0,done=false;
    root.innerHTML='<div class="board memory" role="grid" aria-label="Memory matching board"></div>';
    const el=$('.memory',root);
    function flip(i){
      if(done||busy||tiles[i].match||tiles[i].up)return;
      tiles[i].up=true;beep(520,.03);
      if(first==null){first=i;render();return;}
      moves++;
      if(tiles[first].v===tiles[i].v){
        tiles[first].match=tiles[i].match=true;first=null;beep(760,.06);
        if(tiles.every(t=>t.match)){done=true;setStatus(`All pairs found in ${moves} moves!`,'message-win');recordResult('memory','win');setBest('memory',moves,true);}
        render();
      }else{
        busy=true;render();
        setTimeout(()=>{tiles[first].up=false;tiles[i].up=false;first=null;busy=false;render();},650);
      }
    }
