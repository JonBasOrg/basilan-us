  // Snake
  function startSnake(){
    root.innerHTML='<div class="arcade-wrap"><canvas class="snake-canvas" width="420" height="420" aria-label="Snake game"></canvas><div class="dpad"><button class="mini-btn up">↑</button><button class="mini-btn left">←</button><button class="mini-btn down">↓</button><button class="mini-btn right">→</button></div></div>';const c=$('canvas',root),ctx=c.getContext('2d');const N=21,S=20;let snake=[{x:10,y:10},{x:9,y:10},{x:8,y:10}],dir={x:1,y:0},next={x:1,y:0},food={x:14,y:10},score=0,paused=false,done=false;
    function spawn(){do{food={x:rand(N),y:rand(N)}}while(snake.some(s=>s.x===food.x&&s.y===food.y));}
    function setDir(x,y){if(x===-dir.x&&y===-dir.y)return;next={x,y};}
    function tick(){if(paused||done)return;dir=next;const h={x:snake[0].x+dir.x,y:snake[0].y+dir.y};if(h.x<0||h.x>=N||h.y<0||h.y>=N||snake.some(s=>s.x===h.x&&s.y===h.y)){done=true;setStatus(`Game over — score ${score}.`,'message-loss');recordResult('snake','loss');setBest('snake',score);beep(120,.15);return;}snake.unshift(h);if(h.x===food.x&&h.y===food.y){score++;spawn();beep(650,.04);}else snake.pop();setStatus(`Score: ${score}${paused?' · Paused':''}`);draw();}
    function draw(){ctx.clearRect(0,0,c.width,c.height);ctx.fillStyle='#0d1117';ctx.fillRect(0,0,c.width,c.height);ctx.strokeStyle='#151b24';ctx.lineWidth=1;for(let i=0;i<=N;i++){ctx.beginPath();ctx.moveTo(i*S,0);ctx.lineTo(i*S,c.height);ctx.stroke();ctx.beginPath();ctx.moveTo(0,i*S);ctx.lineTo(c.width,i*S);ctx.stroke();}ctx.fillStyle='#d6ad62';ctx.fillRect(food.x*S+4,food.y*S+4,S-8,S-8);snake.forEach((s,i)=>{ctx.fillStyle=i?'#7899a7':'#bcd4de';ctx.fillRect(s.x*S+2,s.y*S+2,S-4,S-4);});}
    const key=e=>{const k=e.key.toLowerCase();if(k==='arrowup'||k==='w'){e.preventDefault();setDir(0,-1)}else if(k==='arrowdown'||k==='s'){e.preventDefault();setDir(0,1)}else if(k==='arrowleft'||k==='a'){e.preventDefault();setDir(-1,0)}else if(k==='arrowright'||k==='d'){e.preventDefault();setDir(1,0)}else if(k==='p'){paused=!paused;setStatus(`Score: ${score}${paused?' · Paused':''}`);}};window.addEventListener('keydown',key);$$('.dpad button',root).forEach((x,i)=>x.onclick=()=>{[[0,-1],[-1,0],[0,1],[1,0]][i]&&setDir(...[[0,-1],[-1,0],[0,1],[1,0]][i])});const timer=setInterval(tick,115);draw();setStatus('Score: 0');return()=>{clearInterval(timer);window.removeEventListener('keydown',key)};
  }

  // Memory Match
  function startMemory(){
