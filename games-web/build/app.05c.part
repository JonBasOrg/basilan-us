    let b=Array(64).fill(null);for(let y=0;y<3;y++)for(let x=0;x<8;x++)if((x+y)%2)b[y*8+x]={p:2,k:false};for(let y=5;y<8;y++)for(let x=0;x<8;x++)if((x+y)%2)b[y*8+x]={p:1,k:false};let p=1,cursor=40,sel=null,done=false;
    root.innerHTML='<div class="board checkerboard" role="grid" aria-label="Checkers board"></div>';const el=$('.checkerboard',root);
    const xy=i=>[i%8,Math.floor(i/8)], idx=(x,y)=>y*8+x;
    function movesFrom(i,jumpOnly=false){const pc=b[i];if(!pc||pc.p!==p)return[];const [x,y]=xy(i),dirs=pc.k?[[-1,-1],[1,-1],[-1,1],[1,1]]:(pc.p===1?[[-1,-1],[1,-1]]:[[-1,1],[1,1]]),out=[];for(const[dX,dY]of dirs){let nx=x+dX,ny=y+dY;if(nx<0||nx>7||ny<0||ny>7)continue;let j=idx(nx,ny);if(!b[j]&&!jumpOnly)out.push({to:j});else if(b[j]&&b[j].p!==pc.p){let jx=nx+dX,jy=ny+dY;if(jx>=0&&jx<8&&jy>=0&&jy<8&&!b[idx(jx,jy)])out.push({to:idx(jx,jy),jumped:j});}}return out;}
    function allJumps(){let a=[];b.forEach((pc,i)=>{if(pc?.p===p)a.push(...movesFrom(i,true).map(m=>({...m,from:i})));});return a;}
    function move(to){if(sel==null)return;let required=allJumps(),m=(required.length?required.filter(x=>x.from===sel):movesFrom(sel)).find(x=>x.to===to);if(!m)return;let pc=b[sel];b[to]=pc;b[sel]=null;if(m.jumped!=null)b[m.jumped]=null;let y=Math.floor(to/8);if((pc.p===1&&y===0)||(pc.p===2&&y===7))pc.k=true;beep(510,.04);if(m.jumped!=null&&movesFrom(to,true).length){sel=to;cursor=to;setStatus('Jump again with the same piece.');render();return;}p=p===1?2:1;sel=null;cursor=to;if(!b.some(x=>x?.p===p)||!b.some((x,i)=>x?.p===p&&movesFrom(i).length)){done=true;p=p===1?2:1;setStatus(`Player ${p} wins!`,'message-win');recordResult('checkers','win');beep(810,.12);}else setStatus(`Player ${p}'s turn${allJumps().length?' — jump required':''}`);render();}
    function choose(i){if(done)return;if(sel!=null&&i!==sel&&(!b[i]||b[i]?.p!==p)){move(i);return;}if(b[i]?.p===p){sel=i;cursor=i;render();}}
    function render(){let legal=sel==null?[]:(allJumps().length?allJumps().filter(x=>x.from===sel):movesFrom(sel)).map(x=>x.to);el.innerHTML=b.map((pc,i)=>`<button class="cell ${(Math.floor(i/8)+i%8)%2?'dark':'light'} ${i===sel?'selected':''} ${legal.includes(i)?'legal':''} ${i===cursor?'focused':''}" data-i="${i}" aria-label="${pc?`player ${pc.p} ${pc.k?'king':'piece'}`:'empty'}">${pc?`<span class="${pc.p===1?'piece-cream':'piece-red'}">${pc.k?'⛃':'⛀'}</span>`:''}</button>`).join('');$$('.cell',el).forEach(x=>x.onclick=()=>{cursor=+x.dataset.i;choose(cursor)});if(!statusEl.textContent)setStatus(`Player ${p}'s turn`);}
    const key=e=>{let x=cursor%8,y=Math.floor(cursor/8);if(e.key==='ArrowLeft'&&x>0)cursor--;else if(e.key==='ArrowRight'&&x<7)cursor++;else if(e.key==='ArrowUp'&&y>0)cursor-=8;else if(e.key==='ArrowDown'&&y<7)cursor+=8;else if(e.key==='Enter'||e.key===' '){e.preventDefault();choose(cursor);return;}else return;e.preventDefault();render();};window.addEventListener('keydown',key);render();return()=>window.removeEventListener('keydown',key);
  }

  // Chess
  function startChess(){
