  $('#back-btn').addEventListener('click',goHome);
  $('#new-btn').addEventListener('click',()=>{ if(currentGame) openGame(currentGame,true); });
  $('#sound-btn').addEventListener('click',e=>{soundOn=!soundOn;e.currentTarget.textContent=`Sound: ${soundOn?'On':'Off'}`;e.currentTarget.setAttribute('aria-pressed',soundOn);beep(640,.07);});
  window.addEventListener('hashchange',()=>{ const id=location.hash.replace('#',''); if(id && id!=='home' && gameDefs.some(g=>g.id===id)) openGame(id,false,true); else if(id==='home'||!id) goHome(true); });

  function openGame(id, fresh=false, fromHash=false){
    const g=gameDefs.find(x=>x.id===id); if(!g)return;
    cleanup(); cleanup=()=>{}; currentGame=id;
    if(!fromHash) history.replaceState(null,'',`#${id}`);
    home.hidden=true; play.hidden=false; root.innerHTML=''; setStatus('');
    $('#game-title').textContent=g.title; $('#game-kicker').textContent=g.cat; $('#controls-list').innerHTML=controls(g.controls); renderStats();
    cleanup=g.start({fresh})||(()=>{}); setTimeout(()=>root.focus(),0); window.scrollTo({top:0,behavior:'smooth'});
  }
  function goHome(fromHash=false){ cleanup(); cleanup=()=>{};currentGame=null;if(!fromHash)history.replaceState(null,'','#home');play.hidden=true;home.hidden=false;root.innerHTML='';statusEl.textContent=''; window.scrollTo({top:0,behavior:'smooth'}); }

  // Tic Tac Toe
  function startTicTacToe(){
    let board=Array(9).fill(''), turn='X', cursor=0, done=false;
    root.innerHTML='<div class="board ttt" role="grid" aria-label="Tic Tac Toe board"></div>';
    const el=$('.ttt',root);
    function winner(){ const lines=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]; for(const l of lines)if(board[l[0]]&&l.every(i=>board[i]===board[l[0]]))return board[l[0]]; return board.every(Boolean)?'draw':null; }
    function playAt(i){ if(done||board[i])return;board[i]=turn;beep(turn==='X'?520:390); const w=winner(); if(w){done=true;if(w==='draw'){setStatus('Draw — a perfect stalemate.');recordResult('tictactoe','draw');}else{setStatus(`${w} wins!`,'message-win');recordResult('tictactoe','win');beep(760,.12);} }else{turn=turn==='X'?'O':'X';setStatus(`${turn}'s turn`);} render(); }
    function render(){el.innerHTML=board.map((v,i)=>`<button class="cell ${v.toLowerCase()} ${i===cursor?'focused':''}" data-i="${i}" role="gridcell" aria-label="${v||'empty'} cell ${i+1}">${v}</button>`).join('');$$('.cell',el).forEach(b=>b.addEventListener('click',()=>{cursor=+b.dataset.i;playAt(cursor);})); if(!done&&!statusEl.textContent)setStatus(`${turn}'s turn`);}
    const key=e=>{ if(!['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Enter',' '].includes(e.key))return;e.preventDefault();if(e.key==='ArrowLeft')cursor=(cursor+8)%9;if(e.key==='ArrowRight')cursor=(cursor+1)%9;if(e.key==='ArrowUp')cursor=(cursor+6)%9;if(e.key==='ArrowDown')cursor=(cursor+3)%9;if(e.key==='Enter'||e.key===' ')playAt(cursor);else render();};
    window.addEventListener('keydown',key);render();return()=>window.removeEventListener('keydown',key);
  }

  // Minesweeper game
  function startMinesweeper(){
    const W=9,H=9,COUNT=10; let cells=Array.from({length:81},()=>({hazard:false,revealed:false,flag:false,n:0}));let laid=false,done=false,cursor=0,startTime=0;
    root.innerHTML='<div class="board mines" role="grid" aria-label="Minesweeper board"></div>';const el=$('.mines',root);
    function neighbors(i){const x=i%W,y=Math.floor(i/W),a=[];for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){if(!dx&&!dy)continue;const nx=x+dx,ny=y+dy;if(nx>=0&&nx<W&&ny>=0&&ny<H)a.push(ny*W+nx);}return a;}
    function lay(safe){let choices=[...Array(81).keys()].filter(i=>i!==safe&&!neighbors(safe).includes(i));shuffle(choices);choices.slice(0,COUNT).forEach(i=>cells[i].hazard=true);cells.forEach((c,i)=>c.n=neighbors(i).filter(j=>cells[j].hazard).length);laid=true;startTime=Date.now();}
    function reveal(i){if(done||cells[i].flag||cells[i].revealed)return;if(!laid)lay(i);const c=cells[i];c.revealed=true;if(c.hazard){done=true;cells.forEach(x=>{if(x.hazard)x.revealed=true;});setStatus('Game over — try a new board.','message-loss');recordResult('minesweeper','loss');beep(120,.18);render();return;}beep(520,.025);if(c.n===0)neighbors(i).forEach(reveal); if(cells.filter(x=>x.revealed).length===81-COUNT){done=true;const sec=Math.round((Date.now()-startTime)/1000);setStatus(`Field cleared in ${sec}s!`,'message-win');recordResult('minesweeper','win');setBest('minesweeper',sec,true);beep(800,.12);}render();}
    function flag(i){if(done||cells[i].revealed)return;cells[i].flag=!cells[i].flag;beep(330,.025);render();}
