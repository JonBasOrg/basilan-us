    const key=e=>{const map={ArrowLeft:'left',a:'left',A:'left',ArrowRight:'right',d:'right',D:'right',ArrowUp:'up',w:'up',W:'up',ArrowDown:'down',s:'down',S:'down'};if(map[e.key]){e.preventDefault();move(map[e.key]);}};window.addEventListener('keydown',key);$$('.dpad button',root).forEach((x,i)=>x.onclick=()=>move(['up','left','down','right'][i]));root.addEventListener('pointerdown',e=>{startX=e.clientX;startY=e.clientY});root.addEventListener('pointerup',e=>{let dx=e.clientX-startX,dy=e.clientY-startY;if(Math.max(Math.abs(dx),Math.abs(dy))<30)return;move(Math.abs(dx)>Math.abs(dy)?(dx>0?'right':'left'):(dy>0?'down':'up'));});render();return()=>window.removeEventListener('keydown',key);
  }

  // Connect Four
  function startConnect4(){
    const W=7,H=6;let b=Array(W*H).fill(0),p=1,col=3,done=false;root.innerHTML='<div class="board c4" role="grid" aria-label="Four in a Row board"></div>';const el=$('.c4',root);
    function win(player){for(let y=0;y<H;y++)for(let x=0;x<W;x++)for(const [dx,dy] of [[1,0],[0,1],[1,1],[1,-1]]){let ok=true;for(let k=0;k<4;k++){let nx=x+dx*k,ny=y+dy*k;if(nx<0||nx>=W||ny<0||ny>=H||b[ny*W+nx]!==player){ok=false;break;}}if(ok)return true;}return false;}
    function drop(c){if(done)return;for(let y=H-1;y>=0;y--){let i=y*W+c;if(!b[i]){b[i]=p;beep(p===1?520:360,.04);if(win(p)){done=true;setStatus(`Player ${p} wins!`,'message-win');recordResult('connect4','win');beep(800,.12);}else if(b.every(Boolean)){done=true;setStatus('Draw.');recordResult('connect4','draw');}else{p=p===1?2:1;setStatus(`Player ${p}'s turn`);}render();return;}}setStatus('That column is full.');}
    function render(){el.innerHTML=b.map((v,i)=>`<button class="cell ${v?'p'+v:''} ${i%W===col?'focused':''}" data-c="${i%W}" aria-label="${v?'player '+v:'empty'}"></button>`).join('');$$('.cell',el).forEach(x=>x.onclick=()=>{col=+x.dataset.c;drop(col)});if(!done&&!statusEl.textContent)setStatus(`Player ${p}'s turn`);}
    const key=e=>{if(e.key==='ArrowLeft'){e.preventDefault();col=(col+W-1)%W;render()}else if(e.key==='ArrowRight'){e.preventDefault();col=(col+1)%W;render()}else if(e.key==='Enter'||e.key===' '){e.preventDefault();drop(col)}};window.addEventListener('keydown',key);render();return()=>window.removeEventListener('keydown',key);
  }

