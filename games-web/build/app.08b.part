    function select(type,i=0,pos=0){if(done)return;if(type==='lane'&&!lanes[i][pos]?.up)return;sel={type,i,pos};beep(500,.02);render();}
    function moveToLane(li){if(!sel)return;let list=selectedItems();if(!list||!validSequence(list))return;let target=lanes[li].at(-1);if((!target&&list[0].level===13)||canStack(list[0],target)){removeSelected(list.length);lanes[li].push(...list);afterMove();beep(610,.04);render();}}
    function moveToGoal(gi){if(!sel)return;let list=selectedItems();if(!list||list.length!==1)return;let item=list[0],g=goals[gi];if(item.family!==gi)return;if((!g.length&&item.level===1)||(g.length&&g.at(-1).family===item.family&&item.level===g.at(-1).level+1)){removeSelected(1);g.push(item);afterMove();beep(680,.04);checkWin();render();}}
    function removeSelected(n){if(sel.type==='shown')shown.splice(shown.length-n,n);else if(sel.type==='goal')goals[sel.i].splice(goals[sel.i].length-n,n);else if(sel.type==='lane')lanes[sel.i].splice(sel.pos,n);}
    function afterMove(){for(const lane of lanes)if(lane.length&&!lane.at(-1).up)lane.at(-1).up=true;sel=null;checkWin();}
    function checkWin(){if(goals.every(g=>g.length===13)){done=true;setStatus('You won Klondike!','message-win');recordResult('solitaire','win');beep(820,.13);}else setStatus(`Foundations: ${goals.reduce((n,g)=>n+g.length,0)}/52`);}
    function itemLabel(item){return `${levelMarks[item.level-1]}${familyMarks[item.family]}`;}
    function itemHtml(item,attrs='',selected=false){if(!item)return '<div class="card-slot">Empty</div>';if(!item.up)return `<button class="playing-card back" ${attrs} aria-label="face-down playing piece"></button>`;const label=itemLabel(item);return `<button class="playing-card ${isRed(item)?'red':''} ${selected?'selected':''}" ${attrs} aria-label="${label}">${label}<span style="position:absolute;right:7px;bottom:6px;font-size:1.25rem">${familyMarks[item.family]}</span></button>`;}
