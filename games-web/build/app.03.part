    function render(){el.innerHTML=cells.map((c,i)=>`<button class="cell mine-cell ${c.revealed?'revealed':''} ${c.flag?'flagged':''} ${i===cursor?'focused':''} ${c.revealed&&!c.hazard&&c.n?'n'+c.n:''}" data-i="${i}" aria-label="${c.flag?'flagged':c.revealed?(c.hazard?'hazard':c.n+' adjacent hazards'):'covered'}">${c.flag?'⚑':c.revealed?(c.hazard?'✹':c.n||''):''}</button>`).join('');$$('.cell',el).forEach(b=>{b.oncontextmenu=e=>{e.preventDefault();cursor=+b.dataset.i;flag(cursor)};b.onclick=()=>{cursor=+b.dataset.i;reveal(cursor)};});setStatus(done?statusEl.textContent:`${COUNT-cells.filter(c=>c.flag).length} markers remaining`);}
    const key=e=>{const m={ArrowLeft:-1,ArrowRight:1,ArrowUp:-W,ArrowDown:W};if(e.key in m){e.preventDefault();let n=cursor+m[e.key];if(n>=0&&n<81 && !(e.key==='ArrowLeft'&&cursor%W===0)&&!(e.key==='ArrowRight'&&cursor%W===W-1))cursor=n;render();}else if(e.key==='Enter'||e.key===' '){e.preventDefault();reveal(cursor);}else if(e.key.toLowerCase()==='f'){e.preventDefault();flag(cursor);}};window.addEventListener('keydown',key);render();return()=>window.removeEventListener('keydown',key);
  }

  // Sudoku
  function startSudoku(){
    const puzzle='530070000600195000098000060800060003400803001700020006060000280000419005000080079'.split('').map(Number);
    const solution='534678912672195348198342567859761423426853791713924856961537284287419635345286179'.split('').map(Number);
    let board=[...puzzle],cursor=puzzle.findIndex(v=>!v),done=false;
    root.innerHTML='<div class="sudoku-wrap"><div class="board sudoku" role="grid" aria-label="Sudoku board"></div><div class="num-pad" aria-label="Number pad"></div></div>';const el=$('.sudoku',root),pad=$('.num-pad',root);
    function input(n){if(done||puzzle[cursor])return;board[cursor]=n;if(n&&n!==solution[cursor])beep(180,.06);else beep(520,.03); if(board.every((v,i)=>v===solution[i])){done=true;setStatus('Solved! Excellent.','message-win');recordResult('sudoku','win');beep(820,.12);}render();}
    function render(){el.innerHTML=board.map((v,i)=>`<button class="cell ${puzzle[i]?'given':v?'user':''} ${v&&v!==solution[i]?'wrong':''} ${i===cursor?'focused':''}" data-i="${i}" aria-label="row ${Math.floor(i/9)+1} column ${i%9+1} ${v||'empty'}">${v||''}</button>`).join('');$$('.cell',el).forEach(b=>b.onclick=()=>{cursor=+b.dataset.i;render();});pad.innerHTML=[1,2,3,4,5,6,7,8,9,0].map(n=>`<button type="button" data-n="${n}">${n||'⌫'}</button>`).join('');$$('button',pad).forEach(b=>b.onclick=()=>input(+b.dataset.n));if(!done)setStatus('Fill the grid — incorrect entries are highlighted.');}
    const key=e=>{if(/^[1-9]$/.test(e.key)){e.preventDefault();input(+e.key);return;}if(e.key==='Backspace'||e.key==='Delete'||e.key==='0'){e.preventDefault();input(0);return;}const x=cursor%9,y=Math.floor(cursor/9);if(e.key==='ArrowLeft'&&x>0)cursor--;else if(e.key==='ArrowRight'&&x<8)cursor++;else if(e.key==='ArrowUp'&&y>0)cursor-=9;else if(e.key==='ArrowDown'&&y<8)cursor+=9;else return;e.preventDefault();render();};window.addEventListener('keydown',key);render();return()=>window.removeEventListener('keydown',key);
  }

  // 2048
  function start2048(){
    let b=Array(16).fill(0),score=0,done=false,startX=0,startY=0;root.innerHTML='<div><div class="board g2048" aria-label="2048 board"></div><div class="dpad"><button class="mini-btn up">↑</button><button class="mini-btn left">←</button><button class="mini-btn down">↓</button><button class="mini-btn right">→</button></div></div>';const el=$('.g2048',root);function add(){const z=b.map((v,i)=>v?null:i).filter(v=>v!=null);if(z.length)b[z[rand(z.length)]]=Math.random()<.9?2:4;}add();add();
    function line(vals){let a=vals.filter(Boolean),r=[];for(let i=0;i<a.length;i++){if(a[i]===a[i+1]){r.push(a[i]*2);score+=a[i]*2;i++;}else r.push(a[i]);}while(r.length<4)r.push(0);return r;}
    function move(dir){if(done)return;let old=b.join(','),nb=Array(16).fill(0);for(let k=0;k<4;k++){let idx=[];if(dir==='left'||dir==='right')for(let j=0;j<4;j++)idx.push(k*4+j);else for(let j=0;j<4;j++)idx.push(j*4+k);if(dir==='right'||dir==='down')idx.reverse();let vals=line(idx.map(i=>b[i]));idx.forEach((i,j)=>nb[i]=vals[j]);}b=nb;if(b.join(',')!==old){add();beep(460,.025);}if(b.includes(2048)){done=true;setStatus(`2048 reached! Score ${score}.`,'message-win');recordResult('2048','win');setBest('2048',score);beep(830,.12);}else if(!canMove()){done=true;setStatus(`No moves left. Score ${score}.`,'message-loss');recordResult('2048','loss');setBest('2048',score);}render();}
    function canMove(){if(b.includes(0))return true;for(let i=0;i<16;i++){if(i%4<3&&b[i]===b[i+1])return true;if(i<12&&b[i]===b[i+4])return true;}return false;}
    function render(){el.innerHTML=b.map(v=>`<div class="tile" data-v="${v}">${v||''}</div>`).join('');if(!done)setStatus(`Score: ${score}`);}
