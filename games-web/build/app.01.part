(() => {
  'use strict';

  const $ = (s, el=document) => el.querySelector(s);
  const $$ = (s, el=document) => [...el.querySelectorAll(s)];
  const root = $('#game-root');
  const statusEl = $('#game-status');
  const home = $('#home-view');
  const play = $('#play-view');
  const statsKey = 'classic-games-web-stats-v1';
  let cleanup = () => {};
  let currentGame = null;
  let soundOn = false;

  const controls = (rows) => rows.map(([label, keys]) => `<div class="control-row"><span>${label}</span><span class="keys">${keys.map(k=>`<span class="key">${k}</span>`).join('')}</span></div>`).join('');
  const escapeHtml = (s) => String(s).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  const rand = n => Math.floor(Math.random()*n);
  const shuffle = a => { for(let i=a.length-1;i>0;i--){const j=rand(i+1);[a[i],a[j]]=[a[j],a[i]];} return a; };
  const setStatus = (msg, cls='') => { statusEl.className='game-status '+cls; statusEl.textContent=msg; };
  const beep = (freq=440, dur=.05) => { if(!soundOn) return; try{ const AC=window.AudioContext||window.webkitAudioContext; const ctx=new AC(); const o=ctx.createOscillator(),g=ctx.createGain(); o.frequency.value=freq; g.gain.value=.035; o.connect(g);g.connect(ctx.destination);o.start();o.stop(ctx.currentTime+dur); o.onended=()=>ctx.close(); }catch{} };
  function getStats(){ try{return JSON.parse(localStorage.getItem(statsKey))||{};}catch{return {};} }
  function saveStats(s){ localStorage.setItem(statsKey,JSON.stringify(s)); }
  function recordResult(id, result){ const s=getStats(); s[id] ||= {played:0,wins:0,best:null}; s[id].played++; if(result==='win')s[id].wins++; saveStats(s); renderStats(); }
  function setBest(id, value, lower=false){ const s=getStats(); s[id] ||= {played:0,wins:0,best:null}; if(s[id].best==null || (lower ? value<s[id].best : value>s[id].best)) s[id].best=value; saveStats(s); renderStats(); }
  function renderStats(extra=''){ const s=getStats()[currentGame]||{played:0,wins:0,best:null}; $('#session-stats').innerHTML=`<div class="stat"><b>${s.played}</b><span>Played</span></div><div class="stat"><b>${s.wins}</b><span>Wins</span></div><div class="stat"><b>${s.best??'—'}</b><span>Best</span></div>${extra}`; }

  const gameDefs = [
    {id:'tictactoe', title:'Tic-Tac-Toe', icon:'✕○', cat:'Board', desc:'A crisp two-player classic.', controls:[['Move',['Arrows']],['Place',['Enter']],['Mouse',['Click']]], start:startTicTacToe},
    {id:'minesweeper', title:'Minesweeper', icon:'⚑', cat:'Puzzle', desc:'Clear the field without hitting a mine.', controls:[['Move',['Arrows']],['Reveal',['Enter']],['Flag',['F']],['Mouse',['Click','Right-click']]], start:startMinesweeper},
    {id:'sudoku', title:'Sudoku', icon:'9×9', cat:'Logic', desc:'Fill every row, column, and box.', controls:[['Move',['Arrows']],['Number',['1–9']],['Erase',['Del']],['Mouse',['Click']]], start:startSudoku},
    {id:'solitaire', title:'Klondike Solitaire', icon:'♠', cat:'Cards', desc:'Classic draw-one Klondike.', controls:[['Navigate',['Tab']],['Select / move',['Enter']],['Stock',['Click']],['Cards',['Click']]], start:startSolitaire},
    {id:'2048', title:'2048', icon:'2048', cat:'Puzzle', desc:'Slide and merge your way upward.', controls:[['Move',['Arrows','WASD']],['Mouse / touch',['Swipe','Buttons']]], start:start2048},
    {id:'connect4', title:'Four in a Row', icon:'●●', cat:'Board', desc:'Connect four before your opponent.', controls:[['Column',['←','→']],['Drop',['Enter']],['Mouse',['Click']]], start:startConnect4},
    {id:'snake', title:'Snake', icon:'▰', cat:'Arcade', desc:'Eat, grow, and avoid yourself.', controls:[['Steer',['Arrows','WASD']],['Pause',['P']],['Mouse / touch',['Buttons']]], start:startSnake},
    {id:'checkers', title:'Checkers', icon:'⛀', cat:'Board', desc:'Capture every opposing piece.', controls:[['Move cursor',['Arrows']],['Select / move',['Enter']],['Mouse',['Click']]], start:startCheckers},
    {id:'chess', title:'Chess', icon:'♞', cat:'Board', desc:'Full local chess with check detection.', controls:[['Move cursor',['Arrows']],['Select / move',['Enter']],['Mouse',['Click']]], start:startChess},
    {id:'tetris', title:'Tetris', icon:'▦', cat:'Arcade', desc:'Stack falling blocks and clear lines.', controls:[['Move',['←','→','A','D']],['Rotate',['↑','W']],['Soft drop',['↓','S']],['Hard drop',['Space']]], start:startTetris},
    {id:'memory', title:'Memory Match', icon:'◆◆', cat:'Memory', desc:'Find every matching pair.', controls:[['Move',['Arrows']],['Flip',['Enter']],['Mouse',['Click']]], start:startMemory}
  ];

  $('#game-grid').innerHTML = gameDefs.map((g,i)=>`<button class="game-card" data-game="${g.id}" type="button"><span class="card-key">${String(i+1).padStart(2,'0')}</span><span class="icon" aria-hidden="true">${g.icon}</span><h3>${g.title}</h3><p>${g.desc}</p></button>`).join('');
  $$('.game-card').forEach(b=>b.addEventListener('click',()=>openGame(b.dataset.game)));
