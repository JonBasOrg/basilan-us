  // Tetris
  function startTetris(){
    root.innerHTML='<div class="arcade-wrap"><canvas class="tetris-canvas" width="300" height="600" aria-label="Tetris game"></canvas><div class="game-actions"><button class="mini-btn" data-a="left">←</button><button class="mini-btn" data-a="rotate">↻</button><button class="mini-btn" data-a="right">→</button><button class="mini-btn" data-a="down">↓</button><button class="mini-btn" data-a="drop">Drop</button></div></div>';const c=$('canvas',root),ctx=c.getContext('2d'),W=10,H=20,S=30;let board=Array.from({length:H},()=>Array(W).fill(0)),score=0,lines=0,done=false;
    const shapes={I:[[1,1,1,1]],O:[[1,1],[1,1]],T:[[0,1,0],[1,1,1]],S:[[0,1,1],[1,1,0]],Z:[[1,1,0],[0,1,1]],J:[[1,0,0],[1,1,1]],L:[[0,0,1],[1,1,1]]};let piece;
    function newPiece(){let keys=Object.keys(shapes),k=keys[rand(keys.length)];piece={m:shapes[k].map(r=>[...r]),x:Math.floor((W-shapes[k][0].length)/2),y:0,v:1+keys.indexOf(k)};if(collide(piece.x,piece.y,piece.m)){done=true;setStatus(`Game over — ${score} points, ${lines} lines.`,'message-loss');recordResult('tetris','loss');setBest('tetris',score);beep(110,.18);}}
    function collide(x,y,m){for(let r=0;r<m.length;r++)for(let q=0;q<m[r].length;q++)if(m[r][q]&&(x+q<0||x+q>=W||y+r>=H||(y+r>=0&&board[y+r][x+q])))return true;return false;}
    function settle(){piece.m.forEach((r,yy)=>r.forEach((v,xx)=>{if(v&&piece.y+yy>=0)board[piece.y+yy][piece.x+xx]=piece.v;}));let cleared=0;for(let y=H-1;y>=0;y--)if(board[y].every(Boolean)){board.splice(y,1);board.unshift(Array(W).fill(0));cleared++;y++;}if(cleared){lines+=cleared;score+=[0,100,300,500,800][cleared];beep(760,.07);}newPiece();}
    function rotate(){let m=piece.m[0].map((_,i)=>piece.m.map(r=>r[i]).reverse());if(!collide(piece.x,piece.y,m)){piece.m=m;beep(520,.02);draw();}}
    function action(a){if(done)return;if(a==='left'&&!collide(piece.x-1,piece.y,piece.m))piece.x--;if(a==='right'&&!collide(piece.x+1,piece.y,piece.m))piece.x++;if(a==='rotate')rotate();if(a==='down'){if(!collide(piece.x,piece.y+1,piece.m)){piece.y++;score++;}else settle();}if(a==='drop'){while(!collide(piece.x,piece.y+1,piece.m)){piece.y++;score+=2;}settle();}setStatus(`Score: ${score} · Lines: ${lines}`);draw();}
    function draw(){ctx.fillStyle='#0d1117';ctx.fillRect(0,0,c.width,c.height);ctx.strokeStyle='#171d27';for(let x=0;x<=W;x++){ctx.beginPath();ctx.moveTo(x*S,0);ctx.lineTo(x*S,c.height);ctx.stroke()}for(let y=0;y<=H;y++){ctx.beginPath();ctx.moveTo(0,y*S);ctx.lineTo(c.width,y*S);ctx.stroke()}const colors=['','#8ca7bc','#d6ad62','#9d7bc4','#78b590','#d07a71','#6f8fd0','#d19a65'];const cell=(x,y,v)=>{ctx.fillStyle=colors[v];ctx.fillRect(x*S+2,y*S+2,S-4,S-4)};board.forEach((r,y)=>r.forEach((v,x)=>v&&cell(x,y,v)));if(piece)piece.m.forEach((r,y)=>r.forEach((v,x)=>v&&cell(piece.x+x,piece.y+y,piece.v)));}
    const key=e=>{let a;if(e.key==='ArrowLeft'||e.key.toLowerCase()==='a')a='left';else if(e.key==='ArrowRight'||e.key.toLowerCase()==='d')a='right';else if(e.key==='ArrowDown'||e.key.toLowerCase()==='s')a='down';else if(e.key==='ArrowUp'||e.key.toLowerCase()==='w')a='rotate';else if(e.code==='Space')a='drop';if(a){e.preventDefault();action(a)}};window.addEventListener('keydown',key);$$('[data-a]',root).forEach(b=>b.onclick=()=>action(b.dataset.a));newPiece();draw();setStatus('Score: 0 · Lines: 0');const timer=setInterval(()=>action('down'),620);return()=>{clearInterval(timer);window.removeEventListener('keydown',key)};
  }

  // Klondike Solitaire
  function startSolitaire(){
